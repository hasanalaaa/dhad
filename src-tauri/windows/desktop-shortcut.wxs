<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Component Id="DhadDesktopShortcut" Guid="*">
        <Shortcut
          Id="DhadDesktopShortcutLink"
          Directory="DesktopFolder"
          Name="ضاد"
          Description="مساعد الكتابة العربية"
          Target="[INSTALLDIR]dhad-desktop.exe"
          WorkingDirectory="INSTALLDIR"
          Advertise="no" />
        <RegistryKey
          Root="HKCU"
          Key="Software\Dhad\Desktop"
          Action="createAndRemoveOnUninstall">
          <RegistryValue
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
